---
import Base from "../layouts/Base.astro";
---

<Base
  title="Áreas de atuação | Dr. Virlênio de Andrade Lara"
  description="Áreas de atuação do Dr. Virlênio de Andrade Lara: Ortopedia e Traumatologia, cirurgia do joelho, artroscopia e Medicina do Trabalho."
  current="atuacao"
>
  <section class="hero">
    <div class="wrap">
      <p class="kicker">Prática clínica</p>
      <h1>Áreas de atuação</h1>
    </div>
  </section>

  <section class="band band-alt">
    <div class="wrap grid-3">
      <article class="panel">
        <h3>Ortopedia e Traumatologia</h3>
        <p>Diagnóstico, acompanhamento e tratamento de condições do sistema musculoesquelético.</p>
      </article>
      <article class="panel">
        <h3>Cirurgia do joelho e artroscopia</h3>
        <p>Foco da especialização realizada em 1995.</p>
      </article>
      <article class="panel">
        <h3>Medicina do Trabalho</h3>
        <p>Especialista desde 2013.</p>
      </article>
    </div>
    <div class="wrap actions">
      <a class="btn btn-primary" href="/contato">Agendar consulta</a>
    </div>
  </section>
</Base>
