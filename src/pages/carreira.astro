---
import Base from "../layouts/Base.astro";
---

<Base
  title="Trajetória | Dr. Virlênio de Andrade Lara"
  description="Trajetória profissional do Dr. Virlênio de Andrade Lara: formação, aperfeiçoamento e reconhecimentos em Ortopedia e Traumatologia."
  current="trajetoria"
>
  <section class="hero">
    <div class="wrap">
      <p class="kicker">Percurso profissional</p>
      <h1>Trajetória</h1>
      <p class="lead">Desde cedo conviveu com a medicina em casa: o avô era médico; o pai e a avó, farmacêuticos. Decidiu seguir a ortopedia após um acidente da mãe, que deixou sequelas no braço.</p>
      <p class="lead">Hoje atende em Caratinga, Abre Campo e Itaguara. <a href="/contato">Ver locais</a></p>
    </div>
  </section>

  <section class="band band-alt">
    <div class="wrap split">
      <div>
        <h2>Formação</h2>
        <div class="timeline">
          <article class="time-item">
            <p class="year">1987-1992</p>
            <h3>Medicina</h3>
            <p>Faculdade de Medicina de Barbacena (FUNJOB), com passagem pela Santa Casa de Belo Horizonte.</p>
          </article>
          <article class="time-item">
            <p class="year">1995</p>
            <h3>Ortopedia e Traumatologia</h3>
            <p>Especialização, com foco em cirurgia do joelho e artroscopia.</p>
          </article>
          <article class="time-item">
            <p class="year">1997</p>
            <h3>SBOT</h3>
            <p>Título de especialista pela Sociedade Brasileira de Ortopedia e Traumatologia.</p>
          </article>
          <article class="time-item">
            <p class="year">2008</p>
            <h3>Piracema/MG</h3>
            <p>Eleito vice-prefeito.</p>
          </article>
          <article class="time-item">
            <p class="year">2013</p>
            <h3>Medicina do Trabalho</h3>
            <p>Especialista em Medicina do Trabalho.</p>
          </article>
        </div>
      </div>
      <div>
        <h2>Aperfeiçoamento internacional</h2>
        <div class="panel" style="margin-top: 8px;">
          <ul>
            <li>Foot &amp; Ankle Arthroscopy Course, Arthrex, Naples, EUA, 2007</li>
            <li>Treinamento cadavérico em ombro e joelho, Arthrex, Naples, EUA, 2007</li>
            <li>ArthroMiami, Arthrex, Miami, EUA, 2010</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Reconhecimentos</h2>
      <div class="honor-grid">
        <figure>
          <img src="/imgs_carreira/img1.jpeg" alt="Diploma de Cidadania Honorária concedido a Virlênio de Andrade Lara pela Câmara Municipal de Caratinga" />
          <figcaption>Cidadão Honorário de Caratinga, 2017</figcaption>
        </figure>
        <figure>
          <img src="/imgs_carreira/img2.jpeg" alt="Título de Cidadão Honorário do município de Abaeté concedido ao Dr. Virlênio de Andrade Lara" />
          <figcaption>Cidadão Honorário de Abaeté, 2020</figcaption>
        </figure>
      </div>
      <div class="honor-pair">
        <figure>
          <img src="/imgs_carreira/img4.jpeg" alt="Dr. Virlênio de Andrade Lara em cerimônia de honraria" />
          <figcaption>Cerimônia de honraria</figcaption>
        </figure>
        <figure>
          <img src="/imgs_carreira/img3.jpeg" alt="Diploma de Mérito Legislativo concedido a Virlênio de Andrade Lara pela Câmara Municipal de Caratinga" />
          <figcaption>Mérito Legislativo de Caratinga, 2022</figcaption>
        </figure>
      </div>
    </div>
  </section>
</Base>
